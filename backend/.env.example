# Supabase (Free Tier) — PostgreSQL
DATABASE_URL="postgresql://postgres:<password>@<project>.supabase.co:5432/postgres"

# Supabase Storage (fotos, laudos, avatares)
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN="<access-token>"
MERCADO_PAGO_WEBHOOK_SECRET="<webhook-secret>"

# App
API_BASE_URL="https://troca-segura-api.onrender.com"
FRONTEND_URL="https://troca-segura.vercel.app"
PORT=3000

# Taxa da plataforma sobre cada venda (fração — 0.08 = 8%)
PLATFORM_FEE_PERCENTAGE=0.08
