# Supabase (Free Tier) — PostgreSQL
DATABASE_URL="postgresql://postgres:<password>@<project>.supabase.co:5432/postgres"

# Supabase Storage (fotos, laudos, avatares, comprovantes de PIX)
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# App
FRONTEND_URL="https://troca-segura.vercel.app"
PORT=3000

# Autenticação (assinatura dos JWTs emitidos em /auth/login)
JWT_SECRET="<string-longa-e-aleatoria>"

# Taxa fixa da plataforma, paga por comprador E vendedor separadamente (R$)
PLATFORM_FEE_AMOUNT=15

# Chave PIX da empresa — pra onde vai a taxa da plataforma
COMPANY_PIX_KEY="<chave-pix-da-empresa>"
COMPANY_PIX_RECEIVER_NAME="<razao-social-ou-nome>"
