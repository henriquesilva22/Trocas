// ============================================================================
// Troca Segura — Prisma Schema
// PostgreSQL (Supabase Free Tier)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER   // Compra e/ou vende
  TECHNICIAN // Realiza inspeções no Hub físico
  ADMIN
}

enum ProductCategory {
  CELULAR
  NOTEBOOK
  MOUSE
  TECLADO
  FONE
  PECA_PC
  MONITOR
  ACESSORIO
  OUTRO
}

enum ProductCondition {
  NOVO
  SEMINOVO
  USADO_BOM_ESTADO
  USADO_COM_MARCAS
  PARA_PECAS
}

enum ProductStatus {
  DISPONIVEL
  EM_NEGOCIACAO
  RESERVADO
  VENDIDO
  TROCADO
  REMOVIDO
}

enum ProposalStatus {
  PENDENTE
  ACEITA
  REJEITADA
  EXPIRADA
  CANCELADA
}

// Quem fez a proposta mais recente na thread — determina quem pode
// aceitar/recusar: se SELLER (contraproposta), a decisão volta pro buyer.
enum ProposedBy {
  BUYER
  SELLER
}

enum DeliveryMethod {
  ENVIO
  PRESENCIAL
}

// Como cada lado recebe o item que ganhou na troca, depois da inspeção
// aprovar — independente de como os itens chegaram ao Hub (DeliveryMethod).
enum ReceiveMethod {
  RETIRADA_HUB
  ENVIO
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

// Máquina de estados oficial da Negotiation.
// Transições são validadas exclusivamente pelo NegotiationStateMachine
// (ver backend/src/modules/negotiation/domain).
enum NegotiationStatus {
  AGUARDANDO_PAGAMENTO_TAXA // Acordo fechado, aguardando taxa da plataforma (comprador + vendedor)
  AGUARDANDO_DROPOFF        // Taxa confirmada, vendedor ainda não levou ao Hub
  EM_CUSTODIA_FISICA        // Produto entregue fisicamente no Hub
  EM_INSPECAO               // Técnico iniciou a checklist
  INSPECIONADO_REPROVADO    // Reprovado — fluxo de devolução ao vendedor
  INSPECIONADO_E_APROVADO   // Aprovado, lacrado, liberado para pagamento
  PAGAMENTO_PENDENTE        // Valor + chave PIX do vendedor exibidos, aguardando comprador pagar
  COMPROVANTE_ENVIADO       // Comprador anexou comprovante, aguardando confirmação do vendedor
  PAGAMENTO_CONFIRMADO      // Vendedor confirmou recebimento do PIX
  PIN_GERADO                // PIN/QR Code de retirada emitido ao comprador
  FINALIZADO                // Produto retirado, negociação concluída
  CANCELADO                 // Cancelada em qualquer ponto anterior ao pagamento
  EM_ANALISE                // Contestação aberta (ex: reprovação questionada, vendedor diz que não recebeu)
}

enum PlatformFeePayerRole {
  BUYER
  SELLER
}

enum PlatformFeeStatus {
  PENDENTE
  COMPROVANTE_ENVIADO
  CONFIRMADO
}

enum PaymentStatus {
  PENDENTE
  COMPROVANTE_ENVIADO
  CONFIRMADO
  CONTESTADO
}

enum MessageContext {
  PROPOSAL
  NEGOTIATION
}

// ============================================================================
// USER & REPUTATION
// ============================================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  cpf          String?  @unique
  passwordHash String
  avatarUrl    String?
  role         UserRole @default(CUSTOMER)

  // Chave PIX do vendedor — exibida ao comprador após a inspeção aprovar o
  // produto, para ele pagar diretamente (sem gateway, sem custódia).
  pixKey     String?
  pixKeyType PixKeyType?

  // Trust Score (0 a 100), recalculado a cada Review concluída
  trustScore   Int      @default(50)

  // Banimento administrativo — bloqueia login/novas negociações sem apagar
  // histórico (produtos, reviews, negociações passadas continuam íntegros).
  isBanned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations — Catálogo
  productsListed Product[]     @relation("SellerProducts")
  proposalsMade  Proposal[]    @relation("BuyerProposals")

  // Relations — Negociação
  negotiationsAsBuyer  Negotiation[] @relation("BuyerNegotiations")
  negotiationsAsSeller Negotiation[] @relation("SellerNegotiations")

  // Relations — Inspeção (somente para role TECHNICIAN)
  inspectionsPerformed Inspection[] @relation("TechnicianInspections")

  // Relations — Chat
  messagesSent Message[] @relation("SentMessages")

  // Relations — Reputação
  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  // Relations — Administração
  adminActionsPerformed AdminAuditLog[] @relation("AdminActor")

  // Relations — Taxa da plataforma (paga tanto como comprador quanto vendedor)
  platformFeeChargesPaid PlatformFeeCharge[]

  // Relations — Frete (paga quando escolhe receber por envio em vez de retirar no Hub)
  shippingChargesPaid ShippingCharge[]

  @@map("users")
}

// ============================================================================
// CATALOG
// ============================================================================

model Product {
  id          String           @id @default(uuid())
  sellerId    String
  seller      User             @relation("SellerProducts", fields: [sellerId], references: [id])

  title       String
  description String
  category    ProductCategory
  condition   ProductCondition
  priceAsking Decimal          @db.Decimal(10, 2)
  city        String

  // URLs de arquivos no Supabase Storage
  photoUrls   String[]

  // Categorias que o dono aceita receber em troca (array vazio = aceita
  // qualquer categoria). Puramente informativo — não bloqueia proposta.
  acceptedCategories ProductCategory[]

  status      ProductStatus    @default(DISPONIVEL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals         Proposal[] @relation("ProposalsForProduct")
  proposalsOffering Proposal[] @relation("ProposalsOfferingProduct")
  negotiation        Negotiation? @relation("NegotiationForProduct")
  negotiationOffered Negotiation? @relation("NegotiationOfferedProduct")

  @@index([status, category])
  @@map("products")
}

// Proposta imutável: uma vez criada, seus termos (amount, offeredProductId)
// não podem ser editados — apenas ACEITA/REJEITADA/CANCELADA/EXPIRADA. Uma
// contraproposta é uma NOVA linha (ver `respondsTo`), nunca uma edição.
model Proposal {
  id        String         @id @default(uuid())
  productId String
  product   Product        @relation("ProposalsForProduct", fields: [productId], references: [id])

  buyerId   String
  buyer     User           @relation("BuyerProposals", fields: [buyerId], references: [id])

  // Produto que o comprador está oferecendo em troca. Null = proposta 100%
  // em dinheiro (compra direta, sem barter).
  offeredProductId String?
  offeredProduct   Product? @relation("ProposalsOfferingProduct", fields: [offeredProductId], references: [id])

  // Diferença em dinheiro (pode ser 0 numa troca de valores equivalentes).
  amount    Decimal        @db.Decimal(10, 2)
  message   String?

  // Quem fez esta proposta na thread — BUYER (proposta original) ou SELLER
  // (contraproposta do dono do produto). Determina quem pode aceitar/recusar.
  proposedBy ProposedBy    @default(BUYER)

  respondsToId String?
  respondsTo   Proposal?  @relation("ProposalCounter", fields: [respondsToId], references: [id])
  counters     Proposal[] @relation("ProposalCounter")

  status    ProposalStatus @default(PENDENTE)

  createdAt DateTime @default(now())
  expiresAt DateTime

  negotiation Negotiation?

  @@index([productId, status])
  @@map("proposals")
}

// ============================================================================
// HUB DE INSPEÇÃO (Intermediação Física)
// ============================================================================

model Hub {
  id      String @id @default(uuid())
  name    String
  address String
  city    String

  // Coordenadas para Leaflet.js / OpenStreetMap
  latitude  Float
  longitude Float

  // Texto livre, ex: "09:00 - 18:00"
  openingHours String?

  isActive Boolean @default(true)

  negotiations Negotiation[]
  inspections  Inspection[]

  @@map("hubs")
}

// ============================================================================
// NEGOTIATION (núcleo da máquina de estados)
// ============================================================================

model Negotiation {
  id String @id @default(uuid())

  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id])

  productId String  @unique
  product   Product @relation("NegotiationForProduct", fields: [productId], references: [id])

  // Produto do comprador, quando a proposta aceita foi uma troca (barter).
  // Null se a proposta aceita foi 100% em dinheiro.
  offeredProductId String?  @unique
  offeredProduct   Product? @relation("NegotiationOfferedProduct", fields: [offeredProductId], references: [id])

  buyerId  String
  buyer    User   @relation("BuyerNegotiations", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerNegotiations", fields: [sellerId], references: [id])

  hubId String?
  hub   Hub?    @relation(fields: [hubId], references: [id])

  amount Decimal @db.Decimal(10, 2)

  status NegotiationStatus @default(AGUARDANDO_PAGAMENTO_TAXA)

  // Escolha de entrega — cada lado escolhe o próprio método/agenda de forma
  // independente, o dropoff físico em si continua registrado em `droppedOffAt`.
  buyerDeliveryMethod  DeliveryMethod?
  buyerScheduledAt     DateTime?
  sellerDeliveryMethod DeliveryMethod?
  sellerScheduledAt    DateTime?

  // Custódia física — dropoff
  droppedOffAt DateTime?

  // PIN de retirada (gerado após PAGAMENTO_CONFIRMADO)
  pickupPin          String?
  pickupPinExpiresAt DateTime?
  pickupConfirmedAt  DateTime?

  // Como cada lado recebe o item que ganhou (pós-inspeção aprovada) —
  // independente de como os itens chegaram ao Hub. `buyerReceivedAt`/
  // `sellerReceivedAt` marcam entrega física confirmada (por técnico no
  // caso de RETIRADA_HUB, autodeclarada pelo usuário no caso de ENVIO) —
  // FINALIZADO só acontece quando os dois lados aplicáveis estão marcados.
  buyerReceiveMethod  ReceiveMethod?
  buyerReceivedAt     DateTime?
  sellerReceiveMethod ReceiveMethod?
  sellerReceivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection Inspection?
  payment    Payment?
  platformFeeCharges PlatformFeeCharge[]
  shippingCharges    ShippingCharge[]
  messages   Message[]
  reviews    Review[]

  @@index([status])
  @@map("negotiations")
}

// ============================================================================
// INSPECTION (checklist técnico + custódia/prateleira)
// ============================================================================

model Inspection {
  id String @id @default(uuid())

  negotiationId String      @unique
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])

  hubId String
  hub   Hub    @relation(fields: [hubId], references: [id])

  technicianId String
  technician   User   @relation("TechnicianInspections", fields: [technicianId], references: [id])

  // Checklist estruturado (itens, respostas, notas do técnico)
  checklist Json

  photoUrls String[]
  videoUrl  String?
  reportUrl String? // Laudo em PDF (Supabase Storage)

  approved Boolean?

  // Localização física dentro do Hub enquanto aguarda pagamento/retirada
  shelfLocation String?

  // Código do lacre físico aplicado ao produto aprovado
  sealCode String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@map("inspections")
}

// ============================================================================
// PAYMENTS (PIX direto comprador -> vendedor — sem custódia, sem gateway)
// ============================================================================

model Payment {
  id String @id @default(uuid())

  negotiationId String      @unique
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])

  amount Decimal @db.Decimal(10, 2)

  // Snapshot da chave PIX do vendedor no momento da cobrança — preserva o
  // histórico mesmo que o vendedor troque a chave depois.
  sellerPixKey String

  // Comprovante anexado pelo comprador, aguardando confirmação do vendedor.
  receiptUrl         String?
  receiptSubmittedAt DateTime?

  status PaymentStatus @default(PENDENTE)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@map("payments")
}

// Taxa fixa da plataforma (paga por comprador E vendedor, separadamente,
// direto pra chave PIX da empresa) — cobrada no início da negociação, antes
// do dropoff no Hub liberar.
model PlatformFeeCharge {
  id String @id @default(uuid())

  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])

  payerRole PlatformFeePayerRole
  payerId   String
  payer     User                 @relation(fields: [payerId], references: [id])

  amount Decimal @db.Decimal(10, 2)

  receiptUrl         String?
  receiptSubmittedAt DateTime?

  status PlatformFeeStatus @default(PENDENTE)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@unique([negotiationId, payerRole])
  @@map("platform_fee_charges")
}

// Frete cobrado de UM lado (o que escolheu ENVIO em vez de retirar no Hub) —
// mesma forma/fluxo de PlatformFeeCharge (comprovante manual, confirmação),
// só que o valor é fixo (config `SHIPPING_FLAT_FEE`) e tem código de rastreio.
model ShippingCharge {
  id String @id @default(uuid())

  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])

  payerRole PlatformFeePayerRole
  payerId   String
  payer     User                 @relation(fields: [payerId], references: [id])

  amount Decimal @db.Decimal(10, 2)

  // Preenchido pelo técnico/admin depois de despachar o item pro Hub de saída.
  trackingCode String?

  receiptUrl         String?
  receiptSubmittedAt DateTime?

  status PlatformFeeStatus @default(PENDENTE)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@unique([negotiationId, payerRole])
  @@map("shipping_charges")
}

// ============================================================================
// CHAT
// ============================================================================

model Message {
  id String @id @default(uuid())

  context MessageContext

  negotiationId String?
  negotiation   Negotiation? @relation(fields: [negotiationId], references: [id])

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  content String

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([negotiationId])
  @@map("messages")
}

// ============================================================================
// REPUTATION
// ============================================================================

model Review {
  id String @id @default(uuid())

  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])

  reviewerId String
  reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  revieweeId String
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  rating  Int // 1 a 5
  comment String?

  createdAt DateTime @default(now())

  // Cada participante avalia o outro uma única vez por negociação
  @@unique([negotiationId, reviewerId])
  @@map("reviews")
}

// ============================================================================
// ADMIN
// ============================================================================

enum AdminActionType {
  RESOLVE_DISPUTE_APPROVE // EM_ANALISE -> INSPECIONADO_E_APROVADO (retoma o fluxo)
  RESOLVE_DISPUTE_CANCEL  // EM_ANALISE -> CANCELADO
  BAN_USER
  UNBAN_USER
  CREATE_HUB
  UPDATE_HUB
  DEACTIVATE_HUB
  CONFIRM_PLATFORM_FEE
  CONFIRM_SHIPPING
  SET_USER_ROLE
}

// Trilha de auditoria de toda ação privilegiada — nenhuma ação de admin
// (banir usuário, resolver disputa, mexer em Hub) acontece sem deixar
// rastro de quem fez, quando e por quê.
model AdminAuditLog {
  id String @id @default(uuid())

  adminId String
  admin   User   @relation("AdminActor", fields: [adminId], references: [id])

  action AdminActionType

  // Id do recurso afetado (negotiationId, userId ou hubId, dependendo de `action`)
  targetId String

  reason String?

  createdAt DateTime @default(now())

  @@index([targetId])
  @@map("admin_audit_logs")
}
